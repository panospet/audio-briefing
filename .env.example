# audio-briefing configuration
# Copy to .env, fill in real values, and load it before starting the service
# (e.g. `docker run --env-file .env` or `set -a; source .env; set +a`).
# Values shown are the built-in defaults where applicable; secrets must be set.

# ---- HTTP server ----
AUDIO_PORT=8380
AUDIO_BIND=0.0.0.0

# Required: Basic Auth credentials protecting the web player and APIs.
AUTH_USERNAME=
AUTH_PASSWORD=

# ---- Storage ----
# Root directory for generated briefings (date/slot subfolders) and latest.json.
AUDIO_BASE_DIR=
# How many daily folders to keep before deletion.
RETENTION_DAYS=30

# ---- Briefing content ----
# Slot times (Europe/Athens), comma-separated; first -> morning, second -> evening.
SCHEDULE_SLOTS=08:00,20:00
NEWS_SEGMENTS=10
MUSIC_TRACKS=10
# Max characters of each news lead spoken (0 = use full summary).
NEWS_SPEECH_MAX_CHARS=0
# Pause in seconds between TTS calls to avoid edge-tts rate limiting.
TTS_PAUSE_SECONDS=10
TTS_VOICE_NEWS=el-GR-NestorasNeural
TTS_VOICE_INTRO=el-GR-NestorasNeural
# Announce track title/artist before the music item (true/false).
TRACK_INTROS=true

# ---- Upstream services ----
# Dashboard that provides the news block per slot (GET/POST /api/briefing-news).
DASHBOARD_URL=http://localhost:8080
# Navidrome music server (Subsonic API).
NAVIDROME_URL=http://localhost:4533
NAVIDROME_USER=
NAVIDROME_PASS=
# Last.fm API key (fallback env: ND_LASTFM_APIKEY).
LASTFM_API_KEY=
# edge-tts voice service exposing POST /synthesize.
VOICE_SERVICE_URL=http://127.0.0.1:8002

# ---- Notifications (optional) ----
# Telegram bot alerts on failed or degraded generation runs.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
